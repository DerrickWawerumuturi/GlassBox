docs/brand/assets/symbol/*
!docs/brand/assets/symbol/*.svg
!docs/brand/assets/wordmark/
docs/brand/assets/wordmark/*
!docs/brand/assets/wordmark/*.svg

# The editorial guides, published investigation notes, and own reference captures
# are shared documentation. Keep experiments outside this allowlist local.
docs/editorial/
!docs/editorial/
docs/editorial/*
!docs/editorial/*.md
!docs/editorial/articles/
docs/editorial/articles/*
!docs/editorial/articles/*.md
