.venv/
__pycache__/
.env
*.pyc
.DS_Store

# IDE state. dataSources.xml also carries the Neon endpoint hostname.
.idea/

# Growth strategy and market research: private plans, kept out of the repo.
docs/growth/

# Local-only pages: brand workbook, code reviews. The repo is public; these are
# read on localhost and never committed.
docs/brand/
docs/local/

# Shared assistant instructions live in the repository.
frontend/CLAUDE.md

# The Figma plugin: a local tool, never part of the repo.
backend/GlassBox/

# Founder reference screenshots for design work: never published or committed.
frontend/public/inspo/

# Private editorial research, prototype workspaces and third-party reference captures stay local.
docs/editorial/
docs/glassbox-editorial-foundation/

# The adopted editorial standards and a compact brand guide are shared.
!docs/editorial/
!docs/brand/
docs/brand/*
!docs/brand/README.md
!docs/brand/assets/
!docs/brand/assets/**
docs/brand/assets/**/.DS_Store
