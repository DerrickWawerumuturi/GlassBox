# The site's own address (metadata, sitemap, robots), no trailing slash.
# Defaults to https://seeglassbox.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analysis API base URL, no trailing slash.
# Local backend:  http://127.0.0.1:7456 (uvicorn ... --port 7456)
# Deployed:       https://<your-container-app>.azurecontainerapps.io
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:7456

# Product analytics (PostHog, US cloud). Leave the key empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sign in (Auth.js with Google). AUTH_SECRET: any long random string.
# The OAuth client needs http://localhost:3000/api/auth/callback/google as a redirect URI.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the short lived token the API checks; the backend's API_JWT_SECRET must match.
API_JWT_SECRET=

# Optional: shows a Contact link in the footer.
# NEXT_PUBLIC_CONTACT_EMAIL=
